{
  "name": "aurum-demo-casino",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "sim": "esbuild scripts/simulate.ts --bundle --platform=node --format=esm --outfile=.cache/sim.mjs --log-level=error && node .cache/sim.mjs",
    "tune": "esbuild scripts/tune.ts --bundle --platform=node --format=esm --outfile=.cache/tune.mjs --log-level=error && node .cache/tune.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
